msgctxt "Addon Summary"
msgid "DOS (DOSBox-Pure)"
msgstr "DOS (DOSBox-Pure)"

msgctxt "Addon Description"
msgid "DOSBox Pure is a new fork of DOSBox built for RetroArch/Libretro aiming for simplicity and ease of use."
msgstr "DOSBox Pure je nová odvozená verze DOSBoxu vytvořená pro RetroArch/Libretro se zaměřením na jednoduchost a snadné použití."

# Empty string with ID 30000
msgctxt "#30001"
msgid "General"
msgstr "Obecné"

msgctxt "#30002"
msgid "General settings (save states, start menu, fixed FPS)."
msgstr "Obecná nastavení (uložené stavy, nabídka při spuštění, pevná snímková frekvence)."

msgctxt "#30003"
msgid "Force Output FPS"
msgstr "Vynutit výstupní FPS"

msgctxt "#30004"
msgid ""
"Enable this to force output at a fixed rate. Try 60 FPS if you encounter screen tearing or vsync issues.\n"
"Output will have frames skipped at lower rates and frames duplicated at higher rates."
msgstr ""
"Povolením vynutíte výstup s pevnou snímkovou frekvencí. Pokud se obraz trhá nebo máte potíže se vsync, zkuste 60 FPS.\n"
"Při nižších frekvencích se budou snímky vynechávat a při vyšších duplikovat."

