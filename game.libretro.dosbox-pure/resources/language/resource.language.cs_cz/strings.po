msgctxt "#30377"
msgid "486 (slow) - 486 instruction set with memory privilege checks"
msgstr "486 (pomalý) – sada instrukcí 486 s kontrolami oprávnění paměti"

msgctxt "#30378"
msgid "Pentium (slow) - 586 instruction set with memory privilege checks"
msgstr "Pentium (pomalý) – sada instrukcí 586 s kontrolami oprávnění paměti"

