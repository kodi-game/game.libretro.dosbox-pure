msgstr "OPL-2 (AdLib / OPL-2 / Yamaha 3812)"

msgctxt "#30454"
msgid "Dual OPL-2 (Dual OPL-2 used by SoundBlaster Pro 1.0 for stereo sound)"
msgstr "Duální OPL-2 (dvojice OPL-2 používaná kartou Sound Blaster Pro 1.0 pro stereofonní zvuk)"

msgctxt "#30455"
msgid "OPL-3 (AdLib / OPL-3 / Yamaha YMF262)"
msgstr "OPL-3 (AdLib / OPL-3 / Yamaha YMF262)"

