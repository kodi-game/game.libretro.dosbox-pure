msgstr "žádné"

msgctxt "#30449"
msgid "Advanced > SoundBlaster Adlib/FM Mode"
msgstr "Pokročilé > Režim AdLib/FM Sound Blasteru"

msgctxt "#30450"
msgid "The SoundBlaster emulated FM synth mode. All modes are Adlib compatible except CMS."
msgstr "Režim emulovaného FM syntetizéru zařízení Sound Blaster. Všechny režimy kromě CMS jsou kompatibilní se systémem AdLib."

msgctxt "#30451"
msgid "Auto (select based on the SoundBlaster type) (default)"
msgstr "Automaticky (vybrat podle typu Sound Blasteru) (výchozí)"

msgctxt "#30452"
msgid "CMS (Creative Music System / GameBlaster)"
msgstr "CMS (Creative Music System / Game Blaster)"

