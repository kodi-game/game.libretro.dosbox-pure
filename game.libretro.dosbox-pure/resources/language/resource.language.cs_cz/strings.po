msgid "OPL-3 Gold (AdLib Gold / OPL-3 / Yamaha YMF262)"
msgstr "OPL-3 Gold (AdLib Gold / OPL-3 / Yamaha YMF262)"

msgctxt "#30457"
msgid "Advanced > SoundBlaster Adlib Provider"
msgstr "Pokročilé > Implementace emulace AdLib pro Sound Blaster"

msgctxt "#30458"
msgid "Provider for the Adlib emulation. Default has good quality and low performance requirements."
msgstr "Implementace emulace AdLib. Výchozí implementace nabízí dobrou kvalitu a má nízké nároky na výkon."

msgctxt "#30459"
msgid "Default"
msgstr "Výchozí"

msgctxt "#30460"
msgid "High quality Nuked OPL3"
msgstr "Nuked OPL3 ve vysoké kvalitě"

msgctxt "#30461"
msgid "Advanced > Enable Gravis Ultrasound (restart required)"
msgstr "Pokročilé > Povolit Gravis UltraSound (vyžaduje restart)"

msgctxt "#30462"
msgid ""
"Enable Gravis Ultrasound emulation. Settings are fixed at port 0x240, IRQ 5, DMA 3.\n"
"If the ULTRADIR variable needs to be different than the default 'C:\\ULTRASND' you need to issue 'SET ULTRADIR=...' in the command line or in a batch file."
msgstr ""
"Povolí emulaci Gravis UltraSound. Nastavení jsou pevně dána: port 0x240, IRQ 5, DMA 3.\n"
"Pokud má proměnná ULTRADIR obsahovat jinou hodnotu než výchozí 'C:\\ULTRASND', je třeba na příkazovém řádku nebo v dávkovém souboru zadat příkaz 'SET ULTRADIR=...'."

msgctxt "#30463"
msgid "Advanced > Enable Tandy Sound Device (restart required)"
msgstr "Pokročilé > Povolit zvukové zařízení Tandy (vyžaduje restart)"

msgctxt "#30464"
msgid "Enable Tandy Sound Device emulation even when running without Tandy Graphics Adapter emulation."
msgstr "Povolí emulaci zvukového zařízení Tandy i bez emulace grafického adaptéru Tandy."

msgctxt "#30465"
msgid "Advanced > Swap Stereo Channels"
msgstr "Pokročilé > Prohodit stereokanály"

msgctxt "#30466"
msgid ""
"Swap the left and the right audio channel.\n"
"\n"
msgstr ""
"Prohodit levý a pravý zvukový kanál.\n"
"\n"
